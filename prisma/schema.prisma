generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usertest {
  name   String? @db.VarChar(100)
  age    Int?
  number String? @db.VarChar(100)
  id     Int     @id @default(autoincrement())
}

model sw {
  swName  String? @db.VarChar(100)
  swPrice String? @db.VarChar(100)
  swId    Int     @id
}

model product {
  id          String           @id
  name        String
  description String?
  price       Float
  stock       Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  category    product_category
}

model user {
  age       Int?
  id        String   @id @default(uuid())
  address   String?
  createdAt DateTime @default(now())
  email     String?  @unique
  firstName String?
  lastName  String?
  updatedAt DateTime @updatedAt
   imageUrl   String? // Optional field to store image URL
}



model account {
  id       String  @id @default(uuid())
  userId   String  @unique
  password String
  role     String?
  email    String?
}

model account2 {
  id        String   @id @default(uuid())
  userId    String   
  password  String
  role      String?
  email     String?
  createdAt DateTime @default(now())
}

model accounthistory {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  password  String
  role      String?
  email     String?
  operation String
  changedAt DateTime @default(now())
}

model accounthistory3 {
  id        String   @id
  accountId String
  email     String?
  role      String?
  password  String
  updatedAt DateTime @default(now())
}

enum product_category {
  FASHION
  BEAUTY
  SPORTS
  ELECTRONICS
  HOME_INTERIOR
  HOUSEHOLD_SUPPLIES
  KITCHENWARE
}
// 파일업로드 를 위한 스키마  24.08.23
//npx prisma db push  스키마 수정후 디비반영


model ProductUpload {
  id          Int          @id @default(autoincrement())
  title       String       // 제품의 제목 또는 설명
  imageUrl    String?      // 대표 이미지 URL
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[] // 첨부파일과의 관계
}
//이미지 업로드용


model Attachment {
  id             Int           @id @default(autoincrement())
  fileName       String        // 파일 이름
  fileUrl        String        // 파일 경로
  productId      Int           // ProductUpload와의 관계를 위한 외래키
  productUpload  ProductUpload @relation(fields: [productId], references: [id])
}

model userTest1 {
  id      Int      @id @default(autoincrement())
  name    String
  images  imgTest1[]
}

model imgTest1 {
  id       Int      @id @default(autoincrement())
  url      String
  userId   Int
  user     userTest1 @relation(fields: [userId], references: [id])
}


model Product2 {
  id        Int      @id @default(autoincrement())
  name      String
  photos    Photo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  product2  Product2 @relation(fields: [productId], references: [id])
  productId Int
  createdAt DateTime @default(now())
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String
  itemId    Int
  createdAt DateTime @default(now())
}
