generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usertest {
  name   String? @db.VarChar(100)
  age    Int?
  number String? @db.VarChar(100)
  id     Int     @id @default(autoincrement())
}

model product {
  id          String           @id
  name        String
  description String?
  price       Float
  stock       Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  category    product_category
}

model user {
  age       Int?
  id        String   @id @default(uuid())
  address   String?
  createdAt DateTime @default(now())
  email     String?  @unique
  firstName String?
  lastName  String?
  updatedAt DateTime @updatedAt
  imageUrl  String?
}

model account {
  id        String   @id @default(uuid())
  userId    String   @unique
  password  String
  role      String?
  email     String?
  createdAt DateTime @default(now())
}

model account2 {
  id        String   @id @default(uuid())
  userId    String
  password  String
  role      String?
  email     String?
  createdAt DateTime @default(now())
}

model accounthistory {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  password  String
  role      String?
  email     String?
  operation String
  changedAt DateTime @default(now())
}

model accounthistory3 {
  id        String   @id
  accountId String
  email     String?
  role      String?
  password  String
  updatedAt DateTime @default(now())
}

model attachment {
  id            Int           @id @default(autoincrement())
  fileName      String
  fileUrl       String
  productId     Int
  productupload productupload @relation(fields: [productId], references: [id], map: "Attachment_productId_fkey")

  @@index([productId], map: "Attachment_productId_fkey")
}

model image {
  id        Int      @id @default(autoincrement())
  url       String
  itemId    Int
  createdAt DateTime @default(now())
}

model imgtest1 {
  id        Int       @id @default(autoincrement())
  url       String
  userId    Int
  usertest1 usertest1 @relation(fields: [userId], references: [id], map: "imgTest1_userId_fkey")

  @@index([userId], map: "imgTest1_userId_fkey")
}

model photo {
  id        Int      @id @default(autoincrement())
  url       String
  productId Int
  createdAt DateTime @default(now())
  product2  product2 @relation(fields: [productId], references: [id], map: "Photo_productId_fkey")

  @@index([productId], map: "Photo_productId_fkey")
}

model product2 {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime
  photo     photo[]
}

model productupload {
  id         Int          @id @default(autoincrement())
  imageUrl   String?
  createdAt  DateTime     @default(now())
  title      String
  updatedAt  DateTime
  attachment attachment[]
}

model software {
  id          Int       @id @default(autoincrement())
  docsNumber  String?
  SwuserID    String?
  name        String?
  Department  String?
  SwName      String?
  period      String?
  licensKey   String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime?
  madeCompany String?
  etc         String?   @db.Text
}

model softwarehistory {
  id          Int      @id @default(autoincrement())
  docsNumber  String?
  SwuserID    String?
  name        String?
  Department  String?
  SwName      String?
  period      String?
  madeCompany String?
  licensKey   String?
  etc         String?  @db.Text
  changedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model troubleshooting {
  id                Int       @id @default(autoincrement())
  troubleNumber     String
  createdAt         DateTime  @default(now())
  author            String?
  reviewer          String?
  receivedAt        DateTime?
  occurredAt        DateTime?
  requestDepartment String?
  requester         String?
  troubleDetails    String?
  notes             String?
  resolvedAt        DateTime?
  issueCause        String?
  actionsTaken      String?
}

model usertest1 {
  id       Int        @id @default(autoincrement())
  name     String
  imgtest1 imgtest1[]
}

enum product_category {
  FASHION
  BEAUTY
  SPORTS
  ELECTRONICS
  HOME_INTERIOR
  HOUSEHOLD_SUPPLIES
  KITCHENWARE
}
