generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usertest {
  name   String? @db.VarChar(100)
  age    Int?
  number String? @db.VarChar(100)
  id     Int     @id @default(autoincrement())
}

model sw {
  swName  String? @db.VarChar(100)
  swPrice String? @db.VarChar(100)
  swId    Int     @id
}

model product {
  id          String           @id
  name        String
  description String?
  price       Float
  stock       Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  category    product_category
}

model user {
  age       Int?
  id        String   @id @default(uuid())
  address   String?
  createdAt DateTime @default(now())
  email     String?  @unique
  firstName String?
  lastName  String?
  updatedAt DateTime @updatedAt
}

model account {
  id       String  @id @default(uuid())
  userId   String  @unique
  password String
  role     String?
  email    String?
}

model account2 {
  id       String  @id @default(uuid())
  userId   String  @unique
  password String
  role     String?
  email    String?
}

model accounthistory {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  password  String
  role      String?
  email     String?
  operation String
  changedAt DateTime @default(now())
}

model accounthistory3 {
  id        String   @id
  accountId String
  email     String?
  role      String?
  password  String
  updatedAt DateTime @default(now())
}

enum product_category {
  FASHION
  BEAUTY
  SPORTS
  ELECTRONICS
  HOME_INTERIOR
  HOUSEHOLD_SUPPLIES
  KITCHENWARE
}
